{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm run clean && concurrently -n \"vite,laravel,queue,schedule\" -c \"cyan,green,magenta,yellow\" \"vite\" \"php -d memory_limit=2G artisan serve\" \"php -d memory_limit=2G artisan queue:work --sleep=3 --tries=3\" \"php -d memory_limit=2G artisan schedule:work\"",
        "dev:vite": "vite",
        "dev:laravel": "php -d memory_limit=2G artisan serve",
        "dev:queue": "php -d memory_limit=2G artisan queue:work --sleep=3 --tries=3",
        "dev:schedule": "php -d memory_limit=2G artisan schedule:work",
        "clean": "php artisan cache:clear && php artisan config:clear && php artisan route:clear && php artisan view:clear && rm -rf node_modules/.vite",
        "build": "vite build",
        "preview": "vite preview",
        "dev:legacy": "npm run development",
        "development": "npx mix",
        "watch": "npx mix watch",
        "watch-poll": "npx mix watch -- --watch-options-poll=1000",
        "hot": "npx mix watch --hot",
        "prod": "npm run production",
        "production": "npx mix --production",
        "lint": "eslint 'resources/assets/js/*'",
        "lint:ts": "eslint 'resources/js/**/*.{ts,tsx}'"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/postcss": "^4.1.14",
        "autoprefixer": "^10.4.21",
        "bootstrap-sass": "^3.4.3",
        "concurrently": "^9.2.1",
        "eslint": "^9.37.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.26.0",
        "eslint-plugin-prettier": "^5.5.4",
        "jquery": "^3.6.3",
        "laravel-mix": "^6.0.49",
        "laravel-vite-plugin": "^1.3.0",
        "postcss": "^8.5.6",
        "prettier": "^3.6.2",
        "sass": "^1.56.1",
        "sass-loader": "13.*",
        "tailwindcss": "^3.4.18",
        "typescript": "^5.9.3",
        "vite": "^6.3.7",
        "vite-plugin-solid": "^2.11.9",
        "webpack": "^5.100.1",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "@solid-primitives/storage": "^4.3.3",
        "@solidjs/router": "^0.15.3",
        "@tanstack/solid-query": "^5.90.4",
        "@thisbeyond/solid-dnd": "^0.7.5",
        "axios": "^1.12.2",
        "clsx": "^2.1.1",
        "select2": "^4.0.13",
        "solid-js": "^1.9.9",
        "sortablejs": "^1.15.0",
        "tailwind-merge": "^3.3.1",
        "trianglify": "^4.1.1"
    }
}
